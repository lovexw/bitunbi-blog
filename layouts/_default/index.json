{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
{{- $.Scratch.Add "index" (dict "title" .Title "date" (.Date.Format "2006-01-02") "content" (.Plain | htmlUnescape) "permalink" .RelPermalink "categories" .Params.categories "summary" (.Summary | plainify)) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
